  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0"
  },
  "private": true
}