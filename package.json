  "description": "Unofficial student prototype: rooms, routes, schedules and the MDU bus for Campus V\u00e4ster\u00e5s and Eskilstuna (Android, iOS, web).",
  "scripts": {
    "sync": "cap sync",
    "android": "cap sync android && cap open android",
    "ios": "cap sync ios && cap open ios",
